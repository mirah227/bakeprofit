# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NOVAC PAYMENT GATEWAY CONFIGURATION
# Keep NOVAC_MODE="test" during development and testing. Never activate live payments without production approval.
NOVAC_MODE="test"
NOVAC_API_BASE_URL="https://api.novacpayment.com"

# Novac Test Keys (from Novac Dashboard -> Settings -> API Settings -> Test Keys)
NOVAC_TEST_PUBLIC_KEY="nc_testpk_d8ta9kpnlgh3kf9lyo96odwltrsgvj44lti8"
NOVAC_TEST_SECRET_KEY="nc_testsk_mzq1byko4r796pgdvwpodl4hme1g6d76qjoe"

# Optional: Recurring Payment Link Reference created on Novac Dashboard for the ₦2,000/month plan
NOVAC_TEST_MONTHLY_PAYMENT_LINK_REF=""

# Novac Production Keys (only used when NOVAC_MODE="live")
NOVAC_LIVE_PUBLIC_KEY=""
NOVAC_LIVE_SECRET_KEY=""
NOVAC_LIVE_MONTHLY_PAYMENT_LINK_REF=""

# Novac Webhook Security: Official Novac webhook IP whitelist (comma-separated)
NOVAC_WEBHOOK_ALLOWED_IPS="18.233.137.110"
